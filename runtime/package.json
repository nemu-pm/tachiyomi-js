{
  "name": "@nemu.pm/tachiyomi-runtime",
  "version": "0.0.0-dev",
  "description": "Runtime for loading and executing Tachiyomi extensions compiled to JavaScript",
  "repository": {
    "type": "git",
    "url": "https://github.com/nemu-pm/tachiyomi-js.git",
    "directory": "runtime"
  },
  "homepage": "https://github.com/nemu-pm/tachiyomi-js#readme",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "bun": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "node": {
        "types": "./dist/index.node.d.ts",
        "default": "./dist/index.node.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./async": {
      "browser": {
        "types": "./dist/async/index.d.ts",
        "default": "./dist/async/index.js"
      },
      "bun": {
        "types": "./dist/async/index.node.d.ts",
        "default": "./dist/async/index.node.js"
      },
      "node": {
        "types": "./dist/async/index.node.d.ts",
        "default": "./dist/async/index.node.js"
      },
      "default": {
        "types": "./dist/async/index.d.ts",
        "default": "./dist/async/index.js"
      }
    },
    "./worker": {
      "types": "./dist/async/worker.d.ts",
      "default": "./dist/async/worker.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tachiyomi",
    "manga",
    "comic",
    "reader",
    "extension",
    "runtime",
    "kotlin-js",
    "nemu"
  ],
  "license": "MIT",
  "dependencies": {
    "comlink": "^4.4.2",
    "jpeg-js": "^0.4.4",
    "pako": "^3.0.3",
    "upng-js": "^2.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^22.0.0",
    "@types/upng-js": "^2.1.5",
    "typescript": "^5.0.0"
  }
}
